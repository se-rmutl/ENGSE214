        <mxCell id="receivedSig" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Received Signature&#xa;&#39;x7y2...&#39;" vertex="1">
