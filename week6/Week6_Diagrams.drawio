        <mxCell id="hashB" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Hash B&#xa;&#39;a7f3b2...&#39;" vertex="1">
