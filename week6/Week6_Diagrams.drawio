            <mxPoint x="910" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step2" edge="1" parent="1" style="endArrow=classic;html=1;strokeWidth=2;" value="2. ServerHello + Certificate&#xa;(Public Key + CA Signature)">
