        <mxCell id="sign" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Encrypt with&#xa;Alice&#39;s Private Key 🔐" vertex="1">
