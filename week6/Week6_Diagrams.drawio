        <mxCell id="verifyOK" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="✅ Valid" vertex="1">
          <mxGeometry height="30" width="100" x="160" y="380" as="geometry" />
        </mxCell>
        <mxCell id="genKey" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Generate Random&#xa;Session Key (AES)" vertex="1">
