          </mxGeometry>
        </mxCell>
        <mxCell id="step1" edge="1" parent="1" style="endArrow=classic;html=1;strokeWidth=2;" value="1. ClientHello&#xa;(Supported Ciphers)">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
