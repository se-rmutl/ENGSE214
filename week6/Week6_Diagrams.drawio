        <mxCell id="receivedMsg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Received Message&#xa;&#39;I agree to pay $100&#39;" vertex="1">
