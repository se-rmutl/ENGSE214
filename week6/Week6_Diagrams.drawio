        <mxCell id="decrypt" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Decrypt with&#xa;Alice&#39;s Public Key 🔓" vertex="1">
