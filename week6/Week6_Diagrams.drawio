        </mxCell>
        <mxCell id="step3" edge="1" parent="1" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#d79b00;" value="3. Encrypt Session Key&#xa;with Server&#39;s Public Key 🔓">
