        <mxCell id="109" value="Privilege Elevation:&#xa;• UAC (User Account Control)&#xa;• Run as Administrator&#xa;• runas command" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;" parent="1" vertex="1">
