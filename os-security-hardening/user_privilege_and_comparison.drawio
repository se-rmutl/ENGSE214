        </mxCell>
        <mxCell id="110" value="Privilege Elevation:&#xa;• sudo (recommended)&#xa;• su (switch user)&#xa;• sudoers configuration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;" parent="1" vertex="1">
