          <mxGeometry x="164" y="330" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="108" value="Permission Bits (rwx)&#xa;• Read (r / 4)&#xa;• Write (w / 2)&#xa;• Execute (x / 1)&#xa;+ Extended ACL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="464" y="330" width="250" height="90" as="geometry" />
