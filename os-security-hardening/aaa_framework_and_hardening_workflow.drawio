        </mxCell>
        <mxCell id="step5" value="5. Updates &amp; Patches&#xa;• Apply Security Patches&#xa;• Configure Auto-Update&#xa;• Remove Unused Software" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" parent="1" vertex="1">
