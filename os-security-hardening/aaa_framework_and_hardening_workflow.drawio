        <mxCell id="step2" value="2. User Management&#xa;• สร้าง Users&#xa;• ตั้ง Password Policy&#xa;• Configure MFA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" parent="1" vertex="1">
