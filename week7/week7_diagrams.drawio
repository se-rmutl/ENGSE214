        <mxCell id="injection-types" value="Types:&#xa;• SQL Injection (SQLi) - Database manipulation&#xa;• Cross-Site Scripting (XSS) - Client-side code execution&#xa;• Command Injection - OS command execution&#xa;• LDAP Injection - Directory service manipulation&#xa;• XML/XPath Injection - XML data manipulation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="440" height="100" as="geometry" />
        </mxCell>

        <mxCell id="injection-prevention" value="Prevention:&#xa;✅ Parameterized Queries / Prepared Statements&#xa;✅ Output Encoding (Context-specific)&#xa;✅ Input Validation (Whitelist approach)&#xa;✅ WAF (Web Application Firewall)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
