        <mxCell id="dom-code" value="// Vulnerable JS code&#xa;document.write(location.hash)&#xa;// URL: site.com#&lt;script&gt;alert(1)&lt;/script&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontSize=9;fontFamily=Courier New;align=left;" vertex="1" parent="1">
