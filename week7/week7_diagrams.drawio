        <mxCell id="supply-examples" value="Real-World Examples:&#xa;• Log4Shell (Log4j) - 2021&#xa;• SolarWinds Orion - 2020&#xa;• event-stream npm package - 2018&#xa;• Codecov Bash Uploader - 2021" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
