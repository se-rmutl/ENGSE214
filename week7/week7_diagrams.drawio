          <mxGeometry x="60" y="390" width="300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="prevention-list" value="✅ Output Encoding: htmlspecialchars(), textContent&#xa;✅ Content Security Policy (CSP): script-src 'self'&#xa;✅ HTTPOnly Cookies: Prevent JS access to session&#xa;✅ Input Validation: Whitelist allowed characters&#xa;✅ Modern Frameworks: React, Angular escape by default" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1">
